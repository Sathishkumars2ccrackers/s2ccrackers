# Server Configuration
PORT=5000
NODE_ENV=development

# MongoDB Atlas Connection URI
# Replace with your MongoDB Atlas connection string in production
MONGODB_URI=mongodb://127.0.0.1:27017/s2ccrackers

# JWT Authentication
JWT_SECRET=s2c_crackers_festival_jwt_secret_key_2026_production_safe
JWT_EXPIRES_IN=7d

# Business Details
BUSINESS_NAME="S2C Crackers"
BUSINESS_DOMAIN="www.s2ccrackers.com"
BUSINESS_PHONE="+91 94421 87654"
BUSINESS_WHATSAPP_NUMBER="919442187654"
ADMIN_EMAIL="admin@s2ccrackers.com"
BUSINESS_ADDRESS="124/B, Sivakasi Main Road, Viswanatham, Sivakasi, Tamil Nadu - 626123"

# Email Configuration (Nodemailer)
# Configure with your SMTP credentials (e.g. Gmail App Password, SendGrid, Amazon SES)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=orders@s2ccrackers.com
SMTP_PASSWORD=your_smtp_app_password_here

# Frontend Application URL (for CORS and email links)
FRONTEND_URL=http://localhost:5173

# Store Policy Configuration
MIN_ORDER_AMOUNT=500
FREE_DELIVERY_THRESHOLD=3000
DEFAULT_DELIVERY_FEE=150
